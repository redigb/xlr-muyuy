e,"tolera_helada":"baja","agua":"baja","ciclo_meses":10,"t_opt_min":22.0,"t_opt_max":32.0,"ktmp":5.0,"lluvia_opt_min":1000.0,"lluvia_opt_max":1800.0,"valor_mercado":0.5,"cobertura":false,"raiz_profunda":true,"fuente":{"clima":"FAO ECOCROP (aprox., verificar)","zona":"MIDAGRI-SIEA Huanuco"}}],"rotaciones":[{"id":"comun-maiz_duro-maiz_duro-descanso","cultivo_inicial":"maiz_duro","secuencia":["maiz_duro","maiz_duro","descanso"],"puntajes":{"agua":0.6,"suelo":0.3,"ingresos":0.33,"riesgo":1.0,"total":0.56},"confianza":{"clima":"media","agua":"alta","suelo":"media","mercado":"sin_datos"},"explicacion":"Repetir maíz sin descanso agota el suelo y reduce la fertilidad, aunque el riesgo sea bajo; además, el ingreso es bajo comparado con otras opciones. En la zona con lluvias intensas, hay que vigilar la erosión y evitar el barbecho prolongado en los meses secos (5‑9).","validar_con_experto":"Consulta a un agronomo sobre el suelo de tu parcela antes de sembrar Maiz amarillo duro.","es_practica_comun":true},{"id":"maiz_duro-yuca-mucuna","cultivo_inicial":"maiz_duro","secuencia":["maiz_duro","yuca","mucuna"],"puntajes":{"agua":0.6,"suelo":1.0,"ingresos":0.4,"riesgo":0.99,"total":0.75},"confianza":{"clima":"media","agua":"alta","suelo":"media","mercado":"sin_datos"},"explicacion":"El maíz seguido de yuca y mucuna mejora la materia orgánica y fija nitrógeno, aumentando ingresos y salud del suelo; el riesgo sigue siendo bajo. En la temporada seca, protege la mucuna el suelo y requiere riego puntual para la yuca.","validar_con_experto":"Confirma si hay semilla y compradores de Yuca en tu zona.","es_practica_comun":false},{"id":"maiz_duro-frijol-yuca","cultivo_inicial":"maiz_duro","secuencia":["maiz_duro","frijol","yuca"],"puntajes":{"agua":0.6,"suelo":0.8,"ingresos":0.53,"riesgo":0.99,"total":0.73},"confianza":{"clima":"media","agua":"alta","suelo":"media","mercado":"sin_datos"},"explicacion":"El frijol después del maíz aporta nitrógeno y rompe ciclos de plagas, mientras que la yuca