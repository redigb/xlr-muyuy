# Entorno LOCAL del backend. Copia este archivo a backend/.env (Quarkus lo lee solo al arrancar).
# Nunca subas .env a GitHub.

# PostgreSQL local (Laragon): base de desarrollo
DB_URL=jdbc:postgresql://localhost:5432/muyuy
DB_USER=postgres
DB_PASSWORD=

# Clave de Groq (vacía = explicaciones con plantilla, sin llamar a Groq)
GROQ_API_KEY=

# Opcionales (ya tienen valor por defecto)
# MUYUY_DATA_DIR=../data
# CORS_ORIGINS=http://localhost:3000
# TEST_DB_URL=jdbc:postgresql://localhost:5432/muyuy_test
# TEST_DB_USER=postgres
