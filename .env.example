# Copia a .env (NUNCA subas .env a GitHub)
# Dominio de la API (DNS A -> IP de la VM; en Cloudflare: "DNS only"). Alternativa sin dominio: api.<ip-con-guiones>.sslip.io
API_DOMAIN=muyuy-bk.rdev7.net.pe
# Contraseña de PostgreSQL (la usa el servicio db y el backend)
DB_PASSWORD=
# Clave de Groq (pásala por privado)
GROQ_API_KEY=
# Orígenes permitidos (landing, demo web Flutter), separados por coma
CORS_ORIGINS=https://muyuy-landing.example,http://localhost:3000
