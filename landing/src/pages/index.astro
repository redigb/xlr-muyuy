---
import Layout from '../layouts/Layout.astro';
import LandingUI from '../components/LandingUI.jsx';
import { DEFAULT_LOCALE } from '../i18n/copy';
import paquetes from '../data/paquetes.json';

// Update these values when the approved release assets are available.
// PUBLIC_* environment variables can also supply them at build time.
const release = {
  videoUrl: import.meta.env.PUBLIC_MUYUY_VIDEO_EMBED_URL ?? '',
  fieldVideoUrl: import.meta.env.PUBLIC_MUYUY_FIELD_VIDEO_EMBED_URL ?? '',
  apkUrl: import.meta.env.PUBLIC_MUYUY_APK_URL ?? '',
  apkSha256: import.meta.env.PUBLIC_MUYUY_APK_SHA256 ?? 'PENDING_BUILD_HASH_2026...',
  githubUrl: import.meta.env.PUBLIC_MUYUY_GITHUB_URL ?? '',
};

// Accept a YouTube watch/share link or an existing HTTPS embed URL.
function videoEmbedUrl(value: string): string | undefined {
  if (!value.trim()) return undefined;
  try {
    const url = new URL(value);
    if (url.protocol !== 'https:') return undefined;
    const host = url.hostname.toLowerCase();
    let videoId: string | null = null;

    if (host === 'youtu.be') {
      videoId = url.pathname.split('/')[1];
    } else if (['youtube.com', 'www.youtube.com', 'm.youtube.com', 'youtube-nocookie.com', 'www.youtube-nocookie.com'].includes(host)) {
      const segments = url.pathname.split('/');
      videoId = ['embed', 'shorts', 'live'].includes(segments[1])
        ? segments[2]
        : url.searchParams.get('v');
    } else {
      return url.href;
    }

    return videoId && /^[a-zA-Z0-9_-]{11}$/.test(videoId)
      ? 'https://www.youtube-nocookie.com/embed/' + videoId
      : undefined;
  } catch {
    return undefined;
  }
}

// ── Datos reales ───────────────────────────────────────────────────────────
// Snapshot de los paquetes regionales servidos por la API (scripts/sync-data.mjs).
// Nada de valores inventados: calendario, altitud, procedencia y rotaciones
// salen del paquete sellado (NASA POWER 1985–2024).
const ZONES = paquetes.zonas.map((zona) => {
  const paquete = paquetes.paquetes[zona.id];
  return {
    id: zona.id,
    nombre: zona.nombre,
    region: zona.region,
    elevacion_m: zona.elevacion_m,
    cultivos: paquete.cultivos,
    inicioSiembra: paquete.inicio_siembra_mes,
    fuenteClima: paquete.fuente_clima,
    calendar: paquete.calendario,
    rotaciones: paquete.rotaciones,
    nombres: paquete.nombres,
    version: paquete.meta.version,
    hash: String(paquete.meta.hash).replace(/^sha256:/, ''),
    apiUrl: `${paquetes.api}/api/paquete/${zona.id}`,
  };
});
const title = 'Muyuy — Offline Agro-Climatic Intelligence powered by NASA Earth Data';
const description = 'Muyuy is an offline-first agro-climatic prototype for smallholder farmers. Explore seasonal climate risks and crop rotations using NASA Earth data, starting in Huánuco, Peru.';
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description} lang={DEFAULT_LOCALE}>
  <link slot="head" rel="preload" as="image" href={base + 'muyuy-logo.png'} />

  {/*
    Loader + contenido real en el HTML estático. Se ve desde el primer byte
    (buscadores, lectores de pantalla y conexiones lentas leen el proyecto) y
    se queda encima hasta que el terreno 3D pintó su primer frame: la isla
    avanza las etapas con data-stage (LandingUI.jsx → loaderStage).
  */}
  <div id="muyuy-loader" class="loader" data-stage="boot" role="status" aria-busy="true" aria-live="polite">
    <div class="loader-glow" aria-hidden="true"></div>
    <div class="loader-body">
      <div class="loader-mark">
        <img src={base + 'muyuy-logo.png'} alt="" width="1370" height="436" />
      </div>
      <h1 class="sr-only">Muyuy</h1>
      <p class="loader-tagline">NASA data to the last field <em>— even without signal.</em></p>

      <div class="loader-progress" aria-hidden="true"><span></span></div>
      <p class="loader-step">
        <span data-for="boot">Preparing the soil</span>
        <span data-for="terrain">Bringing NASA data down to the field</span>
        <span data-for="render">Sowing the first row</span>
        <span data-for="ready">The season begins</span>
      </p>

      <p class="loader-lead">
        Muyuy helps smallholder farmers compare crop rotations, see seasonal climate risks, and
        carry that information offline. Pilot region: Huánuco, Peru.
      </p>
      <ul class="loader-facts">
        <li>NASA POWER 1985–2024</li>
        <li>Offline after one download</li>
        <li>≈2.5 KB regional core</li>
      </ul>
    </div>
    <p class="loader-meta">NASA Space Apps Challenge 2026 · Huánuco, Peru</p>
  </div>
  <noscript><style>#muyuy-loader { display: none; }</style></noscript>
  <script is:inline>
    // Última red: si la isla nunca arranca (error de JS), no dejar la página tapada.
    setTimeout(function () { var l = document.getElementById('muyuy-loader'); if (l) l.remove(); }, 20000);
  </script>

  <LandingUI
    client:only="react"
    zones={ZONES}
    videoEmbedUrl={videoEmbedUrl(release.videoUrl)}
    fieldVideoEmbedUrl={videoEmbedUrl(release.fieldVideoUrl)}
    apkUrl={release.apkUrl}
    apkSha256={release.apkSha256}
    githubUrl={release.githubUrl}
  >
  </LandingUI>

  <noscript>
    <section class="noscript-message">
      <h1>Muyuy</h1>
      <p>NASA data to the last field — even without signal.</p>
      <p>
        Enable JavaScript to explore the interactive terrain, climate calendar and prototype
        installation guide.
      </p>
    </section>
  </noscript>
</Layout>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    text-align: center;
    background: #090c0b;
    transition: opacity .7s cubic-bezier(.32,.72,0,1), visibility .7s;
  }
  .loader[data-stage="ready"] { opacity: 0; visibility: hidden; pointer-events: none; }

  .loader-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 42%, #2a3d2b 0%, transparent 70%),
      radial-gradient(ellipse 90% 70% at 50% 110%, #1a2618 0%, transparent 65%);
    animation: loader-breathe 4.5s ease-in-out infinite;
  }

  .loader-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 520px);
  }

  .loader-mark img { width: clamp(170px, 26vw, 260px); height: auto; filter: drop-shadow(0 0 28px #cadca633); }

  .loader-tagline {
    margin: 18px 0 0;
    font: 400 clamp(22px, 3.2vw, 30px)/1.2 "Instrument Serif", Georgia, serif;
    color: #f1f3ec;
  }
  .loader-tagline em { color: #cadca6; }

  .loader-progress {
    width: min(100%, 280px);
    height: 2px;
    margin-top: 30px;
    overflow: hidden;
    border-radius: 2px;
    background: #ffffff14;
  }
  .loader-progress span {
    display: block;
    height: 100%;
    width: 18%;
    border-radius: inherit;
    background: linear-gradient(90deg, #8fae6a, #e3f0c4);
    box-shadow: 0 0 12px #cadca680;
    transition: width .9s cubic-bezier(.32,.72,0,1);
  }
  .loader[data-stage="terrain"] .loader-progress span { width: 52%; }
  .loader[data-stage="render"] .loader-progress span { width: 86%; }
  .loader[data-stage="ready"] .loader-progress span { width: 100%; }

  .loader-step {
    position: relative;
    height: 16px;
    margin: 12px 0 0;
    font: 500 10.5px/16px "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #9fae8f;
  }
  .loader-step span { display: none; }
  .loader[data-stage="boot"] [data-for="boot"],
  .loader[data-stage="terrain"] [data-for="terrain"],
  .loader[data-stage="render"] [data-for="render"],
  .loader[data-stage="ready"] [data-for="ready"] { display: inline; }

  .loader-lead {
    max-width: 46ch;
    margin: 34px 0 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: #a5ab9f;
  }

  .loader-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .loader-facts li {
    padding: 4px 10px;
    border: 1px solid #ffffff17;
    border-radius: 999px;
    font: 10.5px/1.6 "JetBrains Mono", ui-monospace, monospace;
    color: #8f978a;
  }

  .loader-meta {
    position: absolute;
    bottom: max(22px, env(safe-area-inset-bottom));
    left: 0;
    right: 0;
    margin: 0;
    font-size: 11px;
    letter-spacing: .06em;
    color: #6f7669;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @keyframes loader-breathe { 50% { opacity: .65; } }

  @media (max-height: 620px) {
    .loader-lead, .loader-facts { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-glow { animation: none; }
    .loader, .loader-progress span { transition: none; }
  }

  .noscript-message {
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 24px;
    color: #d4d4d8;
  }

  .noscript-message h1 {
    margin-bottom: 18px;
    font-size: 48px;
    letter-spacing: -.06em;
  }

  .noscript-message p + p {
    margin-top: 14px;
  }
</style>
