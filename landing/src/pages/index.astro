---
import Layout from '../layouts/Layout.astro';
import LandingUI from '../components/LandingUI.jsx';
import { DEFAULT_LOCALE } from '../i18n/copy';
import paquetes from '../data/paquetes.json';

// Update these values when the approved release assets are available.
// PUBLIC_* environment variables can also supply them at build time.
const release = {
  videoUrl: import.meta.env.PUBLIC_MUYUY_VIDEO_EMBED_URL ?? '',
  fieldVideoUrl: import.meta.env.PUBLIC_MUYUY_FIELD_VIDEO_EMBED_URL ?? '',
  apkUrl: import.meta.env.PUBLIC_MUYUY_APK_URL ?? '',
  apkSha256: import.meta.env.PUBLIC_MUYUY_APK_SHA256 ?? 'PENDING_BUILD_HASH_2026...',
  githubUrl: import.meta.env.PUBLIC_MUYUY_GITHUB_URL ?? '',
};

// Accept a YouTube watch/share link or an existing HTTPS embed URL.
function videoEmbedUrl(value: string): string | undefined {
  if (!value.trim()) return undefined;
  try {
    const url = new URL(value);
    if (url.protocol !== 'https:') return undefined;
    const host = url.hostname.toLowerCase();
    let videoId: string | null = null;

    if (host === 'youtu.be') {
      videoId = url.pathname.split('/')[1];
    } else if (['youtube.com', 'www.youtube.com', 'm.youtube.com', 'youtube-nocookie.com', 'www.youtube-nocookie.com'].includes(host)) {
      const segments = url.pathname.split('/');
      videoId = ['embed', 'shorts', 'live'].includes(segments[1])
        ? segments[2]
        : url.searchParams.get('v');
    } else {
      return url.href;
    }

    return videoId && /^[a-zA-Z0-9_-]{11}$/.test(videoId)
      ? 'https://www.youtube-nocookie.com/embed/' + videoId
      : undefined;
  } catch {
    return undefined;
  }
}

// ── Datos reales ───────────────────────────────────────────────────────────
// Snapshot de los paquetes regionales servidos por la API (scripts/sync-data.mjs).
// Nada de valores inventados: calendario, altitud, procedencia y rotaciones
// salen del paquete sellado (NASA POWER 1985–2024).
const ZONES = paquetes.zonas.map((zona) => {
  const paquete = paquetes.paquetes[zona.id];
  return {
    id: zona.id,
    nombre: zona.nombre,
    region: zona.region,
    elevacion_m: zona.elevacion_m,
    cultivos: paquete.cultivos,
    inicioSiembra: paquete.inicio_siembra_mes,
    fuenteClima: paquete.fuente_clima,
    calendar: paquete.calendario,
    rotaciones: paquete.rotaciones,
    nombres: paquete.nombres,
    version: paquete.meta.version,
    hash: String(paquete.meta.hash).replace(/^sha256:/, ''),
    apiUrl: `${paquetes.api}/api/paquete/${zona.id}`,
  };
});
const title = 'Muyuy — Offline Agro-Climatic Intelligence powered by NASA Earth Data';
const description = 'Muyuy is an offline-first agro-climatic prototype for smallholder farmers. Explore seasonal climate risks and crop rotations using NASA Earth data, starting in Huánuco, Peru.';
const base = import.meta.env.BASE_URL;
---

<Layout title={title} description={description} lang={DEFAULT_LOCALE}>
  <link slot="head" rel="preload" as="image" href={base + 'muyuy-logo.png'} />

  <LandingUI
    client:only="react"
    zones={ZONES}
    videoEmbedUrl={videoEmbedUrl(release.videoUrl)}
    fieldVideoEmbedUrl={videoEmbedUrl(release.fieldVideoUrl)}
    apkUrl={release.apkUrl}
    apkSha256={release.apkSha256}
    githubUrl={release.githubUrl}
  >
    {/*
      Contenido real, renderizado en el HTML estático (sin JavaScript).
      Cumple dos funciones: los buscadores y los lectores de pantalla leen algo
      útil, y en una conexión lenta el visitante ve el proyecto antes de que
      descargue el bundle de React + Three.js. Al hidratar, la isla lo reemplaza.
    */}
    <div slot="fallback" class="ssr-shell">
      <img class="ssr-logo" src={base + 'muyuy-logo.png'} alt="Muyuy" width="1370" height="436" />
      <h1>Muyuy</h1>
      <p class="ssr-tagline">NASA data to the last field — even without signal.</p>
      <p class="ssr-lead">
        Muyuy helps smallholder farmers compare crop rotations, see seasonal climate risks, and
        carry that information offline. Pilot region: Huánuco, Peru.
      </p>
      <ul class="ssr-facts">
        <li>40 years of NASA POWER records (1985–2024)</li>
        <li>Works fully offline after one download</li>
        <li>Regional package of about 2 KB gzipped</li>
      </ul>
      <p class="ssr-meta">NASA Space Apps Challenge 2026 · Opening the interactive 3D terrain…</p>
    </div>
  </LandingUI>

  <noscript>
    <section class="noscript-message">
      <h1>Muyuy</h1>
      <p>NASA data to the last field — even without signal.</p>
      <p>
        Enable JavaScript to explore the interactive terrain, climate calendar and prototype
        installation guide.
      </p>
    </section>
  </noscript>
</Layout>

<style>
  .ssr-shell {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 40px 24px;
    text-align: center;
    background: radial-gradient(ellipse at 50% 40%, #1b2a20 0%, #090c0b 70%);
  }

  .ssr-logo {
    width: clamp(150px, 24vw, 260px);
    height: auto;
  }

  .ssr-shell h1 {
    font: 600 clamp(38px, 6vw, 64px)/1 "Inter", system-ui, sans-serif;
    letter-spacing: -.06em;
    margin: 6px 0 0;
    color: #f4f4f1;
  }

  .ssr-tagline {
    max-width: 44ch;
    font-size: clamp(15px, 2vw, 20px);
    line-height: 1.45;
    color: #cadca6;
  }

  .ssr-lead {
    max-width: 58ch;
    font-size: 14px;
    line-height: 1.65;
    color: #b9bdb2;
  }

  .ssr-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
  }

  .ssr-facts li {
    padding: 5px 11px;
    border: 1px solid #ffffff1f;
    border-radius: 999px;
    font: 11px/1.6 ui-monospace, monospace;
    color: #a9b0a3;
  }

  .ssr-meta {
    margin-top: 10px;
    font-size: 11px;
    letter-spacing: .04em;
    color: #7f8679;
  }

  .noscript-message {
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 24px;
    color: #d4d4d8;
  }

  .noscript-message h1 {
    margin-bottom: 18px;
    font-size: 48px;
    letter-spacing: -.06em;
  }

  .noscript-message p + p {
    margin-top: 14px;
  }
</style>
