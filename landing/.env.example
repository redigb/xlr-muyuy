# ─────────────────────────────────────────────────────────────────────────────
#  Landing de Muyuy — variables opcionales (se leen en build)
#  Copia este archivo a `.env` y rellena lo que tengas. Nada de esto es
#  obligatorio: si falta una variable, la interfaz se degrada con un aviso
#  visible en vez de mostrar un enlace roto.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio público real. Sobreescribe `site` de astro.config.mjs.
# Ejemplo: https://muyuy.rdev7.net.pe
PUBLIC_SITE_URL=

# APK firmado + su hash. Se muestran los DOS o ninguno:
# el botón de descarga solo se activa cuando `apkUrl` es https válido y el
# sha256 tiene exactamente 64 caracteres hexadecimales.
PUBLIC_MUYUY_APK_URL=
PUBLIC_MUYUY_APK_SHA256=

# Repositorio público. Sin esto el footer muestra "GitHub link pending".
PUBLIC_MUYUY_GITHUB_URL=

# Video demo de 30 s: link normal de YouTube o cualquier URL https embebible.
PUBLIC_MUYUY_VIDEO_EMBED_URL=

# Video de la visita a Huánuco (misma regla).
PUBLIC_MUYUY_FIELD_VIDEO_EMBED_URL=
